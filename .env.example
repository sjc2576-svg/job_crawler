# 이 파일을 .env로 복사하고 실제 값을 채워 넣으세요.
# (.env는 .gitignore에 등록되어 있어 저장소에 올라가지 않습니다.)

MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=여기에_실제_비밀번호_입력
MYSQL_DATABASE=jobs
MYSQL_PORT=3306
# PlanetScale/Aiven 등 SSL 인증서가 필요한 매니지드 MySQL을 쓰는 경우에만 설정
# MYSQL_SSL_CA=/path/to/ca.pem

# 아래 명령으로 무작위 값을 생성해서 채워 넣으세요:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=여기에_무작위로_생성한_긴_문자열_입력
