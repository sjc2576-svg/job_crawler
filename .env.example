# 이 파일을 .env로 복사하고 실제 값을 채워 넣으세요.
# (.env는 .gitignore에 등록되어 있어 저장소에 올라가지 않습니다.)

MYSQL_HOST=여기에_Aiven_Host_입력
MYSQL_USER=avnadmin
MYSQL_PASSWORD=여기에_실제_비밀번호_입력
MYSQL_DATABASE=defaultdb
MYSQL_PORT=여기에_Aiven_Port_입력
# Aiven/PlanetScale 등 SSL 인증서가 필요한 매니지드 MySQL을 쓰는 경우에만 설정.
# 저장소에 certs/ca.pem으로 커밋해뒀다면 상대경로 그대로 사용.
MYSQL_SSL_CA=certs/ca.pem

# 아래 명령으로 무작위 값을 생성해서 채워 넣으세요:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=여기에_무작위로_생성한_긴_문자열_입력
